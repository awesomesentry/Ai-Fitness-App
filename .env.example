# Optional: connect the AI Coach to a real LLM API (OpenAI-compatible chat completions).
# If these are not set, the app uses the built-in offline rule-based coach instead.
#
# Examples:
#   OpenAI      -> https://api.openai.com/v1/chat/completions   (model: gpt-4o-mini)
#   Groq        -> https://api.groq.com/openai/v1/chat/completions
#   OpenRouter  -> https://openrouter.ai/api/v1/chat/completions
#   Ollama      -> http://localhost:11434/v1/chat/completions   (no key needed)

VITE_AI_API_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini
