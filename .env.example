# AI configuration - powers BOTH the weekly plan generator (src/lib/aiPlan.js)
# and the coach chat (src/lib/coach.js). OpenAI-compatible chat completions.
#
# Without these the app still works: plans fall back to the built-in engine and
# the coach answers with its offline rule-based failsafe (both say so in the UI).
#
# Examples:
#   OpenAI      -> https://api.openai.com/v1/chat/completions   (model: gpt-4o-mini)
#   Groq        -> https://api.groq.com/openai/v1/chat/completions
#   OpenRouter  -> https://openrouter.ai/api/v1/chat/completions
#   Ollama      -> http://localhost:11434/v1/chat/completions   (no key needed)

VITE_AI_API_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini

# Supabase - powers registration, sign-in and sign-out (src/lib/auth.js).
# Create a project at supabase.com, run supabase/schema.sql in the SQL Editor
# (for the data tables), then fill in both lines. Until they are set the auth
# screen shows a warning and offers a local demo mode.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
